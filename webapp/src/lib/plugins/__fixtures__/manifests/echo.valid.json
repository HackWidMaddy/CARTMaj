{
  "id": "echo",
  "version": "0.3.1",
  "displayName": "Echo",
  "description": "A test fixture that uses every UI extension point and no permission.",
  "platform": ">=1.0.0 <2.0.0",
  "dataVersion": 2,
  "permissions": [],
  "actions": [
    { "id": "list_items", "entry": "engine/items.py:list_items", "timeoutSeconds": 30 },
    { "id": "save_item", "entry": "engine/items.py:save_item", "timeoutSeconds": 30, "resultScreen": "ui/detail.json" },
    { "id": "echo_skill", "entry": "engine/sub/echo.py:echo_skill", "timeoutSeconds": 3600, "async": true }
  ],
  "contributes": {
    "nav": { "label": "Echo", "icon": "puzzle", "screen": "ui/home.json" },
    "chat.session.actions": [{ "label": "Echo this session", "action": "list_items" }],
    "project.skills.row": [{ "label": "Echo skill", "action": "echo_skill" }]
  },
  "screens": ["ui/home.json", "ui/detail.json", "ui/forms/new-item.json"]
}
