# =============================================================================
# .dockerignore — excludes from `docker build` context
# =============================================================================
# ---------- VCS ----------
.git/
.gitignore
.gitattributes

# ---------- Editor / OS junk ----------
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Python bytecode + caches ----------
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/coverage.xml

# ---------- Virtualenvs ----------
services/knowledge_base/.CART-venv/
**/*-env/
**/*-venv/
**/.venv/
**/venv/
**/env/

# ---------- Node / JS ----------
**/node_modules/
**/.next/
**/.nuxt/
**/dist/
**/build/

# ---------- Test scaffolding (don't ship tests into production images) ----------
agentic/tests/
services/knowledge_base/tests/
**/*.test.py
**/*.spec.py

# ---------- Runtime logs (mounted at runtime; shouldn't bake into image) ----------
agentic/logs/
*.log
logs/

# ---------- Agent scratch + worktrees ----------
.claude/

# ---------- Docker meta files (never needed inside the image) ----------
**/Dockerfile
**/docker-compose*.yml
**/.dockerignore

# ---------- Misc ----------
*.bak
*.tmp
*.pid
.env
.env.*
!.env.example

# ---------- Shadows of baked packages ----------
# agentic/Dockerfile bakes services/knowledge_base/ at /app/knowledge_base/ and
# then runs `COPY agentic/ ./`, so anything here would overwrite it. An empty
# kb_config.yaml here replaced the real KB config, and a root-owned local copy
# outlives its removal from git (tests/test_agent_image_no_shadowed_copy.py).
agentic/knowledge_base/

# ---------- Runtime-installed data ----------
# run_amass copies the image's own baked list here on first use; shipping it
# back into the build context would add it to the image a second time.
recon/wordlists/jhaddix-all.txt
